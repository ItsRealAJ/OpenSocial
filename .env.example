# ---------------------------------------------------------------------------
# Copy this file to .env.local and paste in the three values from Supabase.
# Supabase dashboard -> your project -> Project Settings -> API
# ---------------------------------------------------------------------------

# "Project URL". Looks like https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key. Safe to expose in the browser. RLS protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. NEVER expose this in the browser or commit it.
# The ranker uses it server-side to read global engagement counts.
SUPABASE_SERVICE_ROLE_KEY=
