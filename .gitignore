# ---------------------------------------------------------------------------
#  What must never reach the repository
#
#  Two categories: things that are huge and regenerated from source anyway
#  (dependencies, build output, caches), and things that are secret.
#  If you are unsure whether something belongs here, run `git status` before
#  committing and look at what is actually listed.
# ---------------------------------------------------------------------------

# Dependencies. Reinstalled from package-lock.json with `npm install`.
# This is the big one: node_modules is roughly 500MB.
node_modules/
.pnp
.pnp.*
.yarn/

# Build output. Regenerated by `npm run build`.
.next/
out/
build/
dist/

# Tooling caches
.turbo/
.swc/
coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------------
#  Secrets
#
#  Ignore every .env file, then explicitly allow the template back in. Written
#  this way round on purpose: a new .env.production.local you create next month
#  is ignored by default rather than needing a new rule.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Deployment
.vercel

# Certificates and keys
*.pem
*.key
*.p12

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors
.idea/
.vscode/
*.swp
*.swo

# Operating system junk
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
